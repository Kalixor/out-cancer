---
sidebar: false
---

<script setup>
import { onMounted } from 'vue'
import { useRouter } from 'vitepress'   // ← correct source

const router = useRouter()

onMounted(() => {
  const nav = (navigator.language || '').toLowerCase()
  let locale = 'fr'
  if (nav.startsWith('en')) locale = 'en'
  else if (nav.startsWith('ar')) locale = 'ar'
  router.go(`/${locale}/`)             // ← use .go(), not .replace()
})
</script>

<p style="text-align:center;margin-top:2rem;">
  Redirecting… <a href="/fr/">click here</a> if nothing happens.
</p>
